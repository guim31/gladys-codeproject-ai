  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Asks CodeProject.AI for its modules, then analyzes each camera once.",
        "fr": "Demande ses modules à CodeProject.AI, puis analyse chaque caméra une fois.",
        "de": "Fragt CodeProject.AI nach seinen Modulen und analysiert dann jede Kamera einmal.",
        "es": "Pide sus módulos a CodeProject.AI y analiza cada cámara una vez."
      },
      "timeout_seconds": 120
    },
    {
      "key": "register_face",
      "label": {
        "en": "Register a face",
        "fr": "Enregistrer un visage",
        "de": "Gesicht speichern",
        "es": "Registrar un rostro"
      },
      "description": {
        "en": "Stand alone facing an added camera, then run: the face in its picture is saved under this name, for face recognition.",
        "fr": "Placez-vous seul face à une caméra ajoutée, puis lancez : le visage de son image est enregistré sous ce nom, pour la reconnaissance.",
        "de": "Stell dich allein vor eine hinzugefügte Kamera und starte dann: Das Gesicht in ihrem Bild wird unter diesem Namen gespeichert, für die Erkennung.",
        "es": "Colóquese solo frente a una cámara añadida y ejecute: el rostro de su imagen se guarda con este nombre, para el reconocimiento."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": true
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Name of the person",
            "fr": "Nom de la personne",
            "de": "Name der Person",
            "es": "Nombre de la persona"
