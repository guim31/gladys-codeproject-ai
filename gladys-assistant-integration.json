{
  "manifest_version": 1,
  "type": "device",
  "name": "CodeProject.AI",
  "description": {
    "en": "Local object and face detection on your camera images with CodeProject.AI Server, without the cloud.",
    "fr": "Détection locale d’objets et de visages sur vos caméras avec CodeProject.AI Server, sans cloud.",
    "de": "Lokale Objekt- und Gesichtserkennung in deinen Kamerabildern mit CodeProject.AI, ohne Cloud.",
    "es": "Detección local de objetos y rostros en sus cámaras con CodeProject.AI Server, sin nube."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-codeproject-ai:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-codeproject-ai/main/cover.png",
  "categories": ["security"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your CodeProject.AI server",
        "fr": "Votre serveur CodeProject.AI",
        "de": "Dein CodeProject.AI-Server",
        "es": "Su servidor CodeProject.AI"
      },
      "description": {
        "en": "CodeProject.AI Server detects objects (person, car, dog…) and recognizes faces in pictures, on your own machine. Enter its address, then up to four cameras below, and open the Discovery tab: one device per camera, and one for the server.",
        "fr": "CodeProject.AI Server détecte les objets (personne, voiture, chien…) et reconnaît les visages dans des images, sur votre propre machine. Saisissez son adresse, puis jusqu'à quatre caméras ci-dessous, et ouvrez l'onglet Découverte : un appareil par caméra, et un pour le serveur.",
        "de": "CodeProject.AI Server erkennt Objekte (Person, Auto, Hund…) und Gesichter in Bildern, auf deinem eigenen Rechner. Gib seine Adresse und unten bis zu vier Kameras ein und öffne dann den Tab „Entdecken“: ein Gerät pro Kamera und eines für den Server.",
        "es": "CodeProject.AI Server detecta objetos (persona, coche, perro…) y reconoce rostros en imágenes, en su propia máquina. Introduzca su dirección y hasta cuatro cámaras más abajo, y abra la pestaña Descubrir: un dispositivo por cámara y uno para el servidor."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-codeproject-ai/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "CodeProject.AI address",
        "fr": "Adresse de CodeProject.AI",
        "de": "CodeProject.AI-Adresse",
        "es": "Dirección de CodeProject.AI"
      },
      "description": {
        "en": "Without a port, 32168 is used. Add https:// for a reverse proxy.",
        "fr": "Sans port, 32168 est utilisé. Ajoutez https:// derrière un proxy inverse.",
        "de": "Ohne Port wird 32168 verwendet. Füge https:// hinter einem Reverse-Proxy hinzu.",
        "es": "Sin puerto, se usa el 32168. Añada https:// detrás de un proxy inverso."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20",
        "de": "z. B. 192.168.1.20",
        "es": "p. ej. 192.168.1.20"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "labels",
      "type": "string",
      "label": {
        "en": "Objects to look for",
        "fr": "Objets recherchés",
        "de": "Gesuchte Objekte",
        "es": "Objetos buscados"
      },
      "description": {
        "en": "Object labels in English (COCO: person, car, dog…), separated by commas (up to 8, each one a counter). * = every label. A camera can have its own list.",
        "fr": "Étiquettes d'objets en anglais (COCO : person, car, dog…), séparées par des virgules (8 au plus, chacune un compteur). * = toutes. Une caméra peut avoir sa propre liste.",
        "de": "Objekt-Labels auf Englisch (COCO: person, car, dog…), durch Kommas getrennt (bis zu 8, je ein Zähler). * = alle. Eine Kamera kann ihre eigene Liste haben.",
        "es": "Etiquetas de objetos en inglés (COCO: person, car, dog…), separadas por comas (hasta 8, cada una un contador). * = todas. Una cámara puede tener su propia lista."
      },
      "placeholder": {
        "en": "person, car, cat, dog",
        "fr": "person, car, cat, dog",
        "de": "person, car, cat, dog",
        "es": "person, car, cat, dog"
      },
      "required": false,
      "default": "person, car, cat, dog"
    },
    {
      "key": "confidence",
      "type": "select",
      "label": {
        "en": "Minimum confidence",
        "fr": "Confiance minimale",
        "de": "Mindestkonfidenz",
        "es": "Confianza mínima"
      },
      "description": {
        "en": "Detections below are ignored. Higher: fewer false alarms, more misses.",
        "fr": "Les détections en dessous sont ignorées. Plus haut : moins de fausses alertes, plus d'oublis.",
        "de": "Erkennungen darunter werden ignoriert. Höher: weniger Fehlalarme, mehr Übersehenes.",
        "es": "Las detecciones por debajo se ignoran. Más alta: menos falsas alarmas, más omisiones."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 %",
            "fr": "30 %",
            "de": "30 %",
            "es": "30 %"
          }
        },
        {
          "value": "40",
          "label": {
            "en": "40 %",
            "fr": "40 %",
            "de": "40 %",
            "es": "40 %"
          }
        },
        {
          "value": "50",
          "label": {
            "en": "50 %",
            "fr": "50 %",
            "de": "50 %",
            "es": "50 %"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 %",
            "fr": "60 %",
            "de": "60 %",
            "es": "60 %"
          }
        },
        {
          "value": "70",
          "label": {
            "en": "70 %",
            "fr": "70 %",
            "de": "70 %",
            "es": "70 %"
          }
        },
        {
          "value": "80",
          "label": {
            "en": "80 %",
            "fr": "80 %",
            "de": "80 %",
            "es": "80 %"
          }
        },
        {
          "value": "90",
          "label": {
            "en": "90 %",
            "fr": "90 %",
            "de": "90 %",
            "es": "90 %"
          }
        }
      ]
    },
    {
      "key": "interval",
      "type": "select",
      "label": {
        "en": "Analysis interval",
        "fr": "Intervalle d'analyse",
        "de": "Analyseintervall",
        "es": "Intervalo de análisis"
      },
      "description": {
        "en": "Each added camera is analyzed this often, one after the other. Every analysis takes CPU on the CodeProject.AI machine.",
        "fr": "Chaque caméra ajoutée est analysée à ce rythme, l'une après l'autre. Chaque analyse consomme du processeur sur la machine de CodeProject.AI.",
        "de": "Jede hinzugefügte Kamera wird in diesem Takt analysiert, eine nach der anderen. Jede Analyse kostet CPU auf dem CodeProject.AI-Rechner.",
        "es": "Cada cámara añadida se analiza con esta frecuencia, una tras otra. Cada análisis consume CPU en la máquina de CodeProject.AI."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "On demand only",
            "fr": "À la demande seulement",
            "de": "Nur auf Anfrage",
            "es": "Solo bajo demanda"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "900",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "3600",
          "label": {
            "en": "1 hour",
            "fr": "1 heure",
            "de": "1 Stunde",
            "es": "1 hora"
          }
        }
      ]
    },
    {
      "key": "faces",
      "type": "select",
      "label": {
        "en": "Face recognition",
        "fr": "Reconnaissance des visages",
        "de": "Gesichtserkennung",
        "es": "Reconocimiento de rostros"
      },
      "description": {
        "en": "With a person in view, also asks the Face Processing module who it is (faces registered with the Register a face action). Adds a Recognized face feature.",
        "fr": "Avec une personne dans le champ, demande aussi au module Face Processing de qui il s'agit (visages enregistrés par l'action Enregistrer un visage). Ajoute une fonctionnalité Visage reconnu.",
        "de": "Ist eine Person im Bild, fragt zusätzlich das Modul Face Processing, wer es ist (mit der Aktion Gesicht speichern gespeicherte Gesichter). Fügt eine Funktion Erkanntes Gesicht hinzu.",
        "es": "Con una persona a la vista, pregunta también al módulo Face Processing quién es (rostros registrados con la acción Registrar un rostro). Añade una función Rostro reconocido."
      },
      "required": false,
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": {
            "en": "Off",
            "fr": "Désactivée",
            "de": "Aus",
            "es": "Desactivado"
          }
        },
        {
          "value": "on",
          "label": {
            "en": "On",
            "fr": "Activée",
            "de": "An",
            "es": "Activado"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Feature names, objects and scene texts.",
        "fr": "Noms des fonctionnalités, objets et textes des scènes.",
        "de": "Namen der Funktionen, Objekte und Szenentexte.",
        "es": "Nombres de las funciones, objetos y textos de las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
